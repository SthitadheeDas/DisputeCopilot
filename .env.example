# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Application Configuration
# DATA_MODE: 'fixture' (offline sample data) or 'sandbox' (live PayPal Sandbox API)
DATA_MODE=fixture

# DRY_RUN: 'true' will prevent sending mutations to PayPal and preview payloads instead
DRY_RUN=true

# Server Port
PORT=3000
