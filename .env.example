# PayPal Sandbox Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Groq AI (Primary Provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API (Secondary Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Application Configuration
# DATA_MODE: 'fixture' (offline sample data) or 'sandbox' (live PayPal Sandbox API)
DATA_MODE=fixture

# DRY_RUN: 'true' will prevent sending mutations to PayPal and preview payloads instead
DRY_RUN=true

# Server Port
PORT=3000
